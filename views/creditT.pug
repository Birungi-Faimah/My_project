doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Credit Records - Karibu Groceries
    link(rel="stylesheet", href="/css/manager.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap")
  
  body
    .dashboard-container
      // Sidebar Navigation
      aside.sidebar
        .logo-container
          .logo-circle
            img(src="/images/hand.jpg", alt="KGL Logo")
          h2.dashboard-title Karibu Groceries
          p.branch-name Credit Records
        
        nav.sidebar-nav
          ul
            li.nav-item
              a(href="/manager")
                i.fas.fa-chart-pie
                span Dashboard
            li.nav-item
              a(href="/addproduce")
                i.fas.fa-seedling
                span Add Produce
            li.nav-item
              a(href="/addsale")
                i.fas.fa-cash-register
                span Record Sale
            li.nav-item
              a(href="/salesTable")
                i.fas.fa-table
                span Sales Table
            li.nav-item
              a(href="/recordprocurement")
                i.fas.fa-clipboard-list
                span Procurement
            li.nav-item
              a(href="/addCredit")
                i.fas.fa-hand-holding-usd
                span Add Credit
            li.nav-item
              a(href="/creditTable").active
                i.fas.fa-credit-card
                span Credit Records
            li.nav-item.logout
              a(href="/logout")
                i.fas.fa-sign-out-alt
                span Logout

      // Main Content
      main.main-content
        // Header
        header.dashboard-header
          .header-left
            h1 Credit Payment Records
            p.welcome-message Track deferred payments from trusted buyers
          .header-right
            .date-time
              i.fas.fa-calendar-alt
              span#currentDate
            a.export-btn(href="/exportCredits")
              i.fas.fa-download
              | Export CSV
            a.add-btn(href="/addCredit")
              i.fas.fa-plus
              | Add Credit

        // Success Message
        if success
          .alert.alert-success
            i.fas.fa-check-circle
            .alert-content
              h4 Success!
              p Credit record saved successfully.

        // Statistics Summary
        section.stats-section
          .stats-grid
            .stat-card.stat-primary
              .stat-icon
                i.fas.fa-file-invoice-dollar
              .stat-info
                h3 #{totalCredits || 0}
                p Total Credits
            .stat-card.stat-warning
              .stat-icon
                i.fas.fa-coins
              .stat-info
                h3 UGX #{totalAmount ? totalAmount.toLocaleString() : 0}
                p Total Amount Due
            .stat-card.stat-orange
              .stat-icon
                i.fas.fa-clock
              .stat-info
                h3 #{pendingCredits || 0}
                p Pending
            .stat-card.stat-success
              .stat-icon
                i.fas.fa-check-circle
              .stat-info
                h3 #{paidCredits || 0}
                p Paid

        // Search and Filter
        section.filter-section
          .filter-container
            .search-box
              i.fas.fa-search
              input#searchInput(type="text", placeholder="Search by buyer name, NIN, produce...")
            .filter-actions
              select#statusFilter
                option(value="") All Status
                option(value="pending") Pending
                option(value="paid") Paid
                option(value="overdue") Overdue
              select#branchFilter
                option(value="") All Branches
                option(value="Maganjo") Maganjo
                option(value="Matugga") Matugga

        // Credit Table
        section.content-section
          .content-card
            .card-header
              h2
                i.fas.fa-credit-card
                | Credit Records
            
            .card-body
              if credits && credits.length > 0
                .table-responsive
                  table.data-table#creditTable
                    thead
                      tr
                        th #
                        th Buyer
                        th NIN
                        th Location
                        th Contact
                        th Produce
                        th Tonnage
                        th Amount (UGX)
                        th Agent
                        th Branch
                        th Due Date
                        th Status
                        th Actions
                    tbody
                      each credit, index in credits
                        tr
                          td #{index + 1}
                          td 
                            .buyer-info
                              i.fas.fa-user
                              | #{credit.buyerName}
                          td #{credit.nin}
                          td #{credit.location}
                          td #{credit.contact}
                          td #{credit.produceName}
                          td #{credit.tonnage} kg
                          td.amount UGX #{credit.amountDue ? credit.amountDue.toLocaleString() : 0}
                          td #{credit.salesAgentName}
                          td 
                            span.branch-badge #{credit.branch}
                          td #{credit.dueDate ? new Date(credit.dueDate).toLocaleDateString() : 'N/A'}
                          td
                            span.status-badge(class="status-#{credit.status || 'pending'}") #{credit.status || 'pending'}
                          td.actions
                            a.action-btn.edit(href=`/editCredit/${credit._id}`, title="Edit")
                              i.fas.fa-edit
                            a.action-btn.delete(href=`/deleteCredit/${credit._id}`, title="Delete", onclick="return confirm('Are you sure you want to delete this credit record?')")
                              i.fas.fa-trash
              else
                .empty-state
                  i.fas.fa-inbox
                  h3 No Credit Records
                  p Start by adding your first credit record.
                  a.add-btn(href="/addCredit")
                    i.fas.fa-plus
                    | Add First Credit

    // Footer
    footer.footer
      p © 2025 Karibu Groceries Limited. All rights reserved.
      p Developed by Birungi Faimah Khan

    script.
      // Display current date
      const dateElement = document.getElementById('currentDate');
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateElement.textContent = new Date().toLocaleDateString('en-UG', options);
      
      // Search functionality
      document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchValue = this.value.toLowerCase();
        const table = document.getElementById('creditTable');
        if (!table) return;
        
        const rows = table.getElementsByTagName('tr');
        
        for (let i = 1; i < rows.length; i++) {
          const cells = rows[i].getElementsByTagName('td');
          let found = false;
          for (let j = 0; j < cells.length; j++) {
            if (cells[j].textContent.toLowerCase().includes(searchValue)) {
              found = true;
              break;
            }
          }
          rows[i].style.display = found ? '' : 'none';
        }
      });
      
      // Status filter
      document.getElementById('statusFilter').addEventListener('change', function() {
        const filterValue = this.value.toLowerCase();
        const table = document.getElementById('creditTable');
        if (!table) return;
        
        const rows = table.getElementsByTagName('tr');
        
        for (let i = 1; i < rows.length; i++) {
          const statusBadge = rows[i].querySelector('.status-badge');
          if (!filterValue || (statusBadge && statusBadge.textContent.toLowerCase().includes(filterValue))) {
            rows[i].style.display = '';
          } else {
            rows[i].style.display = 'none';
          }
        }
      });
      
      // Branch filter
      document.getElementById('branchFilter').addEventListener('change', function() {
        const filterValue = this.value.toLowerCase();
        const table = document.getElementById('creditTable');
        if (!table) return;
        
        const rows = table.getElementsByTagName('tr');
        
        for (let i = 1; i < rows.length; i++) {
          const branchBadge = rows[i].querySelector('.branch-badge');
          if (!filterValue || (branchBadge && branchBadge.textContent.toLowerCase().includes(filterValue))) {
            rows[i].style.display = '';
          } else {
            rows[i].style.display = 'none';
          }
        }
      });
