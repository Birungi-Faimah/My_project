doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sign Up - Karibu Groceries
    link(rel='stylesheet' href='/css/signup.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css')
  
  body
    .signup-container
      .logo-container
        img(src='/images/hand.jpg' alt='Karibu Groceries Logo')
      h2 Sign Up
      form#signup-form(action="/SignUp" method='POST' autocomplete='on')
        .form-group
          label(for='firstname') First Name
          .input-with-icon
            input#firstname(type='text' name='firstname' autocomplete='given-name' required)
            i.fas.fa-user
          span#first-name-error.error-message
        
        .form-group
          label(for='lastname') Last Name
          .input-with-icon
            input#lastname(type='text' name='lastname' autocomplete='family-name' required)
            i.fas.fa-user
          span#last-name-error.error-message
        
        .form-group
          label(for='email') Email
          .input-with-icon
            input#email(type='email' name='email' autocomplete='email' required)
            i.fas.fa-envelope
          span#email-error.error-message
        
        .form-group
          label(for='password') Password
          .input-with-icon
            input#password(type='password' name='password' autocomplete='new-password' required)
            i.fas.fa-lock
          span#password-error.error-message
        
        .form-group
          label(for='confirmPassword') Confirm Password
          .input-with-icon
            input#confirmPassword(type='password' name='confirmPassword' autocomplete='new-password' required)
            i.fas.fa-lock
          span#confirm-password-error.error-message
        
        .form-group
          label(for='role') Role
          .select-with-icon
            select#role(name='role' required)
              option(value='' disabled selected) Select Role
              option(value='manager') Manager
              option(value='director') Director
              option(value='salesagent') Sales Agent
            i.fas.fa-briefcase
          span#role-error.error-message
        
        .form-group
          label(for='branch') Branch Name
          .select-with-icon
            select#branch(name='branch')
              option(value='' disabled selected) Select Branch
              option(value='Maganjo') Maganjo
              option(value='Matugga') Matugga
              option(value='Head Office') Head Office
            i.fas.fa-map-marker-alt
          span#branch-error.error-message
        
        button(type='submit') Sign Up
      
      .login-link
        | Already have an account? 
        a(href='/login') Login here
    
    script(src='/js/signup.js')
