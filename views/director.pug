doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Director Dashboard - Karibu Groceries
    link(rel="stylesheet", href="/css/dashboard.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap")
  
  body
    .dashboard-container
      // Sidebar Navigation
      aside.sidebar
        .logo-container
          .logo-circle
            img(src="/images/hand.jpg", alt="KGL Logo")
          h2.dashboard-title Karibu Groceries
          p.branch-name Director
        
        nav.sidebar-nav
          ul
            li.nav-item
              a(href="/director").active
                i.fas.fa-chart-pie
                span Dashboard
            li.nav-item
              a(href="/logout")
                i.fas.fa-sign-out-alt
                span Logout

      // Main Content
      main.main-content
        // Header
        header.dashboard-header
          .header-left
            h1 Director Dashboard
            p.welcome-message Welcome, Mr. Orban
          .header-right
            .date-time
              i.fas.fa-calendar-alt
              span#currentDate

        // Company Overview Section
        section.company-overview
          h2.section-title
            i.fas.fa-building
            | Company Overview
          .overview-cards
            .overview-card.total-procured
              .card-icon
                i.fas.fa-weight-hanging
              .card-content
                h3 #{companyStats && companyStats.totalProcured ? companyStats.totalProcured.toLocaleString() : 0}
                p Total Procured (kg)
            .overview-card.total-sales
              .card-icon
                i.fas.fa-coins
              .card-content
                h3 UGX #{companyStats && companyStats.totalSalesAmount ? companyStats.totalSalesAmount.toLocaleString() : 0}
                p Total Revenue
            .overview-card.total-credit
              .card-icon
                i.fas.fa-hand-holding-usd
              .card-content
                h3 UGX #{companyStats && companyStats.totalCredit ? companyStats.totalCredit.toLocaleString() : 0}
                p Total Credit
            .overview-card.current-stock
              .card-icon
                i.fas.fa-warehouse
              .card-content
                h3 #{companyStats ? (companyStats.totalProcured || 0) - (companyStats.totalSold || 0) : 0}
                p Current Stock (kg)

        // Quick Actions Section
        section.quick-actions-section
          h2.section-title
            i.fas.fa-bolt
            | Quick Actions
          .quick-actions-grid
            a.quick-action-card(href="/salesTable")
              .action-icon.blue
                i.fas.fa-chart-line
              .action-info
                h3 View Sales
                p All sales transactions
            a.quick-action-card(href="/creditTable")
              .action-icon.orange
                i.fas.fa-hand-holding-usd
              .action-info
                h3 Credit Records
                p View all credit payments
            a.quick-action-card(href="/recordprocurement")
              .action-icon.green
                i.fas.fa-clipboard-list
              .action-info
                h3 Procurement
                p View procurement records
            a.quick-action-card(href="/exportCompany")
              .action-icon.purple
                i.fas.fa-download
              .action-info
                h3 Export Report
                p Download company data

        // Branch Comparison Section
        section.branch-comparison
          h2.section-title
            i.fas.fa-code-branch
            | Branch Performance
          .branch-grid
            each branchData, branchName in branchStats
              .branch-card
                .branch-header
                  h3 
                    i.fas.fa-map-marker-alt
                    | #{branchName} Branch
                .branch-stats
                  .stat-row
                    span.label Total Procured
                    span.value #{branchData.totalProcured.toLocaleString()} kg
                  .stat-row
                    span.label Current Stock
                    span.value #{branchData.currentStock.toLocaleString()} kg
                  .stat-row
                    span.label Total Revenue
                    span.value UGX #{branchData.totalSalesAmount.toLocaleString()}
                  .stat-row
                    span.label Sales Count
                    span.value #{branchData.totalSalesCount}
                  .stat-row
                    span.label Credit Amount
                    span.value.warning UGX #{branchData.totalCredit.toLocaleString()}
                  .stat-row
                    span.label Pending Credits
                    span.value #{branchData.pendingCredits}

        // Produce Performance Section
        section.produce-performance
          h2.section-title
            i.fas.fa-seedling
            | Produce Performance
          .produce-table-container
            table.produce-table
              thead
                tr
                  th Produce Type
                  th Total Procured (kg)
                  th Total Sold (kg)
                  th Revenue (UGX)
              tbody
                each stats, type in produceStats
                  tr
                    td
                      i.fas.fa-leaf
                      | #{type}
                    td #{stats.procured.toLocaleString()}
                    td #{stats.sold.toLocaleString()}
                    td UGX #{stats.revenue.toLocaleString()}

    // Footer
    footer.footer
      .footer-left
        p © 2025 Karibu Groceries Limited
      .footer-right
        p Developed by Birungi Faimah Khan
      p Developed by Birungi Faimah Khan

    script.
      // Display current date
      const dateElement = document.getElementById('currentDate');
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateElement.textContent = new Date().toLocaleDateString('en-UG', options);
