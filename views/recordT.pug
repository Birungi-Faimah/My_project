doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Procurement List - Karibu Groceries
    link(rel="stylesheet", href="/css/manager.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap")
  
  body
    .dashboard-container
      // Sidebar Navigation
      aside.sidebar
        .logo-container
          .logo-circle
            img(src="/images/hand.jpg", alt="KGL Logo")
          h2.dashboard-title Karibu Groceries
          p.branch-name Procurement
        
        nav.sidebar-nav
          ul
            li.nav-item
              a(href="/manager")
                i.fas.fa-chart-pie
                span Dashboard
            li.nav-item
              a(href="/addproduce")
                i.fas.fa-seedling
                span Add Produce
            li.nav-item
              a(href="/addsale")
                i.fas.fa-cash-register
                span Record Sale
            li.nav-item
              a(href="/salesTable")
                i.fas.fa-table
                span Sales Table
            li.nav-item
              a(href="/recordprocurement").active
                i.fas.fa-clipboard-list
                span Procurement List
            li.nav-item
              a(href="/addCredit")
                i.fas.fa-hand-holding-usd
                span Add Credit
            li.nav-item
              a(href="/creditTable")
                i.fas.fa-credit-card
                span Credit Records
            li.nav-item.logout
              a(href="/logout")
                i.fas.fa-sign-out-alt
                span Logout

      // Main Content
      main.main-content
        // Header
        header.dashboard-header
          .header-left
            h1 Procurement Records
            p.welcome-message View and manage all produce procurement
          .header-right
            .date-time
              i.fas.fa-calendar-alt
              span#currentDate
            a.export-btn(href="/exportProcurement")
              i.fas.fa-download
              | Export CSV
            a.add-btn(href="/addproduce")
              i.fas.fa-plus
              | Add Produce

        // Success Message
        if success
          .alert.alert-success
            i.fas.fa-check-circle
            .alert-content
              h4 Success!
              p Procurement record saved successfully.

        // Statistics Summary
        section.stats-section
          .stats-grid
            .stat-card.stat-primary
              .stat-icon
                i.fas.fa-seedling
              .stat-info
                h3 #{totalProcurements || 0}
                p Total Procurements
            .stat-card.stat-success
              .stat-icon
                i.fas.fa-weight-hanging
              .stat-info
                h3 #{totalTonnage ? totalTonnage.toLocaleString() : 0}
                p Total Tonnage (kg)
            .stat-card.stat-info
              .stat-icon
                i.fas.fa-coins
              .stat-info
                h3 UGX #{totalCost ? totalCost.toLocaleString() : 0}
                p Total Investment

        // Search and Filter
        section.filter-section
          .filter-container
            .search-box
              i.fas.fa-search
              input#searchInput(type="text", placeholder="Search by produce name, dealer...")
            .filter-actions
              select#branchFilter
                option(value="") All Branches
                option(value="Maganjo") Maganjo
                option(value="Matugga") Matugga

        // Procurement Table
        section.content-section
          .content-card
            .card-header
              h2
                i.fas.fa-clipboard-list
                | All Procurement Records
            
            .card-body
              if produces && produces.length > 0
                .table-responsive
                  table.data-table#procurementTable
                    thead
                      tr
                        th #
                        th Produce
                        th Type
                        th Tonnage (kg)
                        th Cost (UGX)
                        th Unit Price
                        th Dealer
                        th Contact
                        th Branch
                        th Date
                        th Actions
                    tbody
                      each produce, index in produces
                        tr
                          td #{index + 1}
                          td 
                            .produce-info
                              i.fas.fa-seedling
                              | #{produce.produceName}
                          td #{produce.produceType}
                          td #{produce.tonnage ? produce.tonnage.toLocaleString() : 0}
                          td.amount UGX #{produce.cost ? produce.cost.toLocaleString() : 0}
                          td UGX #{produce.salePrice ? produce.salePrice.toLocaleString() : 0}/kg
                          td #{produce.dealerName}
                          td #{produce.contact}
                          td 
                            span.branch-badge #{produce.branch}
                          td #{produce.producedateandtime ? new Date(produce.producedateandtime).toLocaleDateString() : 'N/A'}
                          td.actions
                            a.action-btn.edit(href=`/editProduce/${produce._id}`, title="Edit")
                              i.fas.fa-edit
                            form.delete-form(action=`/deleteProduce/${produce._id}` method="POST" style="display:inline")
                              button.action-btn.delete(type="submit" title="Delete" onclick="return confirm('Are you sure you want to delete this record?')")
                                i.fas.fa-trash
              else
                .empty-state
                  i.fas.fa-inbox
                  h3 No Procurement Records
                  p Start by adding your first produce procurement.
                  a.add-btn(href="/addproduce")
                    i.fas.fa-plus
                    | Add First Produce

    // Footer
    footer.footer
      .footer-left
        p © 2025 Karibu Groceries Limited
      .footer-right
        p Developed by Birungi Faimah Khan
      p Developed by Birungi Faimah Khan

    script.
      // Display current date
      const dateElement = document.getElementById('currentDate');
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateElement.textContent = new Date().toLocaleDateString('en-UG', options);
      
      // Search functionality
      document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchValue = this.value.toLowerCase();
        const table = document.getElementById('procurementTable');
        if (!table) return;
        
        const rows = table.getElementsByTagName('tr');
        
        for (let i = 1; i < rows.length; i++) {
          const cells = rows[i].getElementsByTagName('td');
          let found = false;
          for (let j = 0; j < cells.length; j++) {
            if (cells[j].textContent.toLowerCase().includes(searchValue)) {
              found = true;
              break;
            }
          }
          rows[i].style.display = found ? '' : 'none';
        }
      });
      
      // Branch filter
      document.getElementById('branchFilter').addEventListener('change', function() {
        const filterValue = this.value.toLowerCase();
        const table = document.getElementById('procurementTable');
        if (!table) return;
        
        const rows = table.getElementsByTagName('tr');
        
        for (let i = 1; i < rows.length; i++) {
          const branchCell = rows[i].querySelector('.branch-badge');
          if (!filterValue || (branchCell && branchCell.textContent.toLowerCase().includes(filterValue))) {
            rows[i].style.display = '';
          } else {
            rows[i].style.display = 'none';
          }
        }
      });
