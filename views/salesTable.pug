doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Sales Records - Karibu Groceries
    link(rel="stylesheet", href="/css/manager.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap")
  
  body
    .dashboard-container
      // Sidebar Navigation
      aside.sidebar
        .logo-container
          .logo-circle
            img(src="/images/hand.jpg", alt="KGL Logo")
          h2.dashboard-title Karibu Groceries
          p.branch-name Sales Records
        
        nav.sidebar-nav
          ul
            li.nav-item
              a(href="/manager")
                i.fas.fa-chart-pie
                span Dashboard
            li.nav-item
              a(href="/addproduce")
                i.fas.fa-seedling
                span Add Produce
            li.nav-item
              a(href="/addsale")
                i.fas.fa-cash-register
                span Record Sale
            li.nav-item
              a(href="/salesTable").active
                i.fas.fa-table
                span Sales Table
            li.nav-item
              a(href="/recordprocurement")
                i.fas.fa-clipboard-list
                span Procurement
            li.nav-item
              a(href="/addCredit")
                i.fas.fa-hand-holding-usd
                span Add Credit
            li.nav-item
              a(href="/creditTable")
                i.fas.fa-credit-card
                span Credit Records
            li.nav-item.logout
              a(href="/logout")
                i.fas.fa-sign-out-alt
                span Logout

      // Main Content
      main.main-content
        // Header
        header.dashboard-header
          .header-left
            h1 Sales Payment Records
            p.welcome-message View and manage all sales transactions
          .header-right
            .date-time
              i.fas.fa-calendar-alt
              span#currentDate
            a.export-btn(href="/exportSales")
              i.fas.fa-download
              | Export CSV

        // Statistics Summary
        section.stats-section
          .stats-grid
            .stat-card.stat-primary
              .stat-icon
                i.fas.fa-shopping-cart
              .stat-info
                h3 #{totalSales || 0}
                p Total Sales
            .stat-card.stat-success
              .stat-icon
                i.fas.fa-coins
              .stat-info
                h3 UGX #{totalRevenue ? totalRevenue.toLocaleString() : 0}
                p Total Revenue
            .stat-card.stat-info
              .stat-icon
                i.fas.fa-weight-hanging
              .stat-info
                h3 #{totalTonnage ? totalTonnage.toLocaleString() : 0}
                p Total Tonnage (kg)

        // Search and Filter
        section.filter-section
          .filter-container
            .search-box
              i.fas.fa-search
              input#searchInput(type="text", placeholder="Search by buyer name, produce...")
            .filter-actions
              select#branchFilter
                option(value="") All Branches
                option(value="Maganjo") Maganjo
                option(value="Matugga") Matugga
              select#dateFilter
                option(value="") All Time
                option(value="today") Today
                option(value="week") This Week
                option(value="month") This Month

        // Sales Table
        section.content-section
          .content-card
            .card-header
              h2
                i.fas.fa-receipt
                | Sales Transactions
              a.add-btn(href="/addsale")
                i.fas.fa-plus
                | Add Sale
            
            .card-body
              if sales && sales.length > 0
                .table-responsive
                  table.data-table#salesTable
                    thead
                      tr
                        th #
                        th Buyer Name
                        th Produce
                        th Tonnage (kg)
                        th Amount (UGX)
                        th Sales Agent
                        th Branch
                        th Date
                        th Time
                        th Actions
                    tbody
                      each sale, index in sales
                        tr
                          td #{index + 1}
                          td 
                            .buyer-info
                              i.fas.fa-user
                              | #{sale.buyerName}
                          td #{sale.produceName}
                          td #{sale.tonnageSold}
                          td.amount UGX #{sale.amountPaid ? sale.amountPaid.toLocaleString() : 0}
                          td #{sale.salesAgentName}
                          td 
                            span.branch-badge #{sale.branch || 'N/A'}
                          td #{sale.saleDate ? new Date(sale.saleDate).toLocaleDateString() : 'N/A'}
                          td #{sale.saleTime || 'N/A'}
                          td.actions
                            a.action-btn.edit(href=`/updateSale?id=${sale._id}`, title="Edit")
                              i.fas.fa-edit
                            a.action-btn.delete(href=`/deleteSale?id=${sale._id}`, title="Delete", onclick="return confirm('Are you sure you want to delete this record?')")
                              i.fas.fa-trash
              else
                .empty-state
                  i.fas.fa-inbox
                  h3 No Sales Records
                  p Start by adding your first sale record.
                  a.add-btn(href="/addsale")
                    i.fas.fa-plus
                    | Add First Sale

    // Footer
    footer.footer
      .footer-left
        p © 2025 Karibu Groceries Limited. All rights reserved.
        .footer-links
          a(href="#") Privacy Policy
          a(href="#") Terms of Service
          a(href="#") Support
      .footer-right
        .footer-social
          a(href="#" title="Facebook")
            i.fab.fa-facebook-f
          a(href="#" title="Twitter")
            i.fab.fa-twitter
          a(href="#" title="LinkedIn")
            i.fab.fa-linkedin-in
        .footer-developer
          | Developed by Birungi Faimah Khan

    script.
      // Display current date
      const dateElement = document.getElementById('currentDate');
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      dateElement.textContent = new Date().toLocaleDateString('en-UG', options);
      
      // Search functionality
      document.getElementById('searchInput').addEventListener('keyup', function() {
        const searchValue = this.value.toLowerCase();
        const table = document.getElementById('salesTable');
        const rows = table.getElementsByTagName('tr');
        
        for (let i = 1; i < rows.length; i++) {
          const cells = rows[i].getElementsByTagName('td');
          let found = false;
          for (let j = 0; j < cells.length; j++) {
            if (cells[j].textContent.toLowerCase().includes(searchValue)) {
              found = true;
              break;
            }
          }
          rows[i].style.display = found ? '' : 'none';
        }
      });
