doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width,initial-scale=1")
    title Login - Karibu Groceries
    link(rel="stylesheet", href="/css/login.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css")
  
  body
    .login-container
      .logo
        img(src="images/hand.jpg", alt="Karibu Groceries Logo")
        h1 Welcome back!
        h2 Login
      
      form#loginForm(action="/login", method="post", autocomplete="on")
        .form-group
          label(for="email") Email:
          .input-container
            input#email(type="email", name="email", autocomplete="email" required)
            span.input-icon 👤
          span.error-message#emailError
        
        .form-group
          label(for="password") Password:
          .input-container
            input#password(type="password", name="password", autocomplete="current-password" required)
            span.input-icon 🔒
          span.error-message#passwordError
        
        button(type="submit") Login
        
        #loginMessage.message
        
        .register-link
          | Don't have an account? 
          a(href="/Signup") Register here
    
    script(src="/js/login.js")
